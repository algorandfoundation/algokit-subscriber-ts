{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "declaration": false,
    "paths": {
      "@algorandfoundation/algokit-subscriber": ["../../src/index.ts"],
      "@algorandfoundation/algokit-subscriber/types/*": ["../../src/types/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
